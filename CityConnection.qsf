# PCB gate-level (City Connection) — sprite stage
set_global_assignment -name VERILOG_FILE rtl/citycon/pld/ttl_74ls161.v
set_global_assignment -name VERILOG_FILE rtl/citycon/pld/ttl_74ls283.v
